/* Milestone 3G: real sdGun.Shoot -> sdBullet collision -> native character damage.
   Stationary fixtures freeze world scheduling, not the projectile/damage methods. */
const {chromium}=require(process.env.PLAYWRIGHT_MODULE||'playwright');
const assert=require('node:assert/strict'),fs=require('node:fs');
const dir=process.env.INTEGRATED_TEST_OUTPUT||'docs/integrated-combat-3g';fs.mkdirSync(dir,{recursive:true});
(async()=>{
 const browser=await chromium.launch({executablePath:process.env.CHROMIUM_PATH,headless:true,args:['--no-sandbox','--enable-unsafe-swiftshader','--disable-dev-shm-usage']});
 const context=await browser.newContext({viewport:{width:1280,height:960}}),page=await context.newPage();
 const r={date:new Date().toISOString(),browser:browser.version(),passed:false,checks:[],errors:[],external:[],badResponses:[],balance:[],nativeMacOSTested:false};
 page.on('pageerror',e=>r.errors.push(e.stack));page.on('dialog',d=>d.dismiss());page.on('response',q=>{if(q.status()>=400)r.badResponses.push(q.url());});
 await context.route('**/*',q=>{if(new URL(q.request().url()).hostname!=='127.0.0.1'){r.external.push(q.request().url());return q.abort();}return q.continue();});
 const check=(name,data)=>{r.checks.push({name,data});console.log('PASS',name,JSON.stringify(data));};
 const ticks=async n=>{const f=await page.evaluate(()=>sdWorld.frame);await page.waitForFunction(f=>sdWorld.frame>=f,f+n,{timeout:120000});};
 try{
  await page.goto('http://127.0.0.1:8000/?mode=combat&movement=1&art=1&physical=1',{waitUntil:'domcontentloaded',timeout:120000});
  await page.waitForFunction(()=>document.getElementById('server_status')?.textContent==='Offline — ready',null,{timeout:120000});
  await page.locator('#offline_play').click();await page.waitForFunction(()=>globalThis.sdFactionLab&&document.getElementById('faction-controls')&&sdWorld.my_entity?.hea>0,null,{timeout:120000});
  await page.waitForFunction(()=>sdRenderer.dark_tint<=0,null,{timeout:120000});
  check('Integrated laboratory loads with native storage origin',await page.evaluate(()=>({namespace:localforage.config().name,art:sdArtLab.mode,playerHP:sdWorld.my_entity.hmax,archetypes:Object.keys(sdFactionLab.archetypes)})));
  await page.evaluate(()=>{
   globalThis.integratedResume=sdWorld.HandleWorldLogic;sdWorld.HandleWorldLogic=()=>{};sdWorld.GSPEED=1;
   const lab=sdFactionLab;
   globalThis.integratedFixture={
    tidy(){for(const e of sdEntity.entities.slice())if(e._is_being_removed){e._remove();sdEntity.RemoveEntityFromEntitiesArray(e);}},
    pose(c){c.stability=100;c._weapon_draw_timer=0;c._key_states.Reset();c._crouch_intens=0;c.sx=c.sy=0;c._hitbox_last_update=-Infinity;c.UpdateHitbox();sdWorld.UpdateHashPosition(c,false);if(!c._ragdoll)c._ragdoll=new sdCharacterRagdoll(c);c._ragdoll._smooth_x=c.x;c._ragdoll._smooth_y=c.y;c._ragdoll._smooth_look_x=c.look_x;c._ragdoll._smooth_look_y=c.look_y;},
    fresh(id='irregular',training){this.tidy();const e=lab.encounter(id,training?{training}:{}),p=sdWorld.my_entity;e._ai_enabled=sdCharacter.AI_MODEL_NONE;e.x=656;e.y=144;p.x=560;p.y=144;e.look_x=560;e.look_y=140;p.look_x=656;p.look_y=144;this.target=e;for(const c of [p,e])this.pose(c);if(e._shield_ent){e._shield_ent.onThink(0);e._shield_ent.UpdateHitbox();sdWorld.UpdateHashPosition(e._shield_ent,false);}return e;},
    snapshot(e=this.target){return {hp:e.hea,armor:e.armor,shield:e._shield_ent?.hea??0,phase:sdPhysicalCombat.state(e)?.phase};},
    fire(kind='pistol',dy=3){
     const e=this.target,p=sdWorld.my_entity,g=lab.equip(p,kind);p.look_x=e.x;p.look_y=e.y+dy;this.pose(p);this.pose(e);p.fire_anim=0;p.reload_anim=0;p._recoil=0;
     for(let i=0;i<14;i++){p._ragdoll.AliveUpdate();p._ragdoll.Think(1);}g.reload_time_left=0;g.ammo_left=sdGun.classes[g.class].ammo_capacity===-1?-1:100;
     const start=sdEntity.entities.length,before=this.snapshot(),random=Math.random;Math.random=()=>.5;
     try{if(!g.Shoot(0,p.GetBulletSpawnOffset()))throw Error('Native Shoot rejected '+kind);}finally{Math.random=random;}
     const bullets=sdEntity.entities.slice(start).filter(b=>b instanceof sdBullet&&b._owner===p);
     for(const b of bullets)for(let i=0;i<30&&!b._is_being_removed;i++){b.UpdateHitbox();b.onThink(1);sdWorld.UpdateHashPosition(b,false);}
     const after=this.snapshot();return {weapon:kind,before,after,hpLoss:before.hp-after.hp,armorLoss:before.armor-after.armor,shieldLoss:before.shield-after.shield,bullets:bullets.length,hit:sdPhysicalCombat.state(e)?.last};
    },
    step(n){const e=this.target;for(let i=0;i<n;i++){sdWorld.time+=1000/30;sdWorld.frame++;e.onThink(1);sdWorld.UpdateHashPosition(e,false);if(e._shield_ent&&!e._shield_ent._is_being_removed){e._shield_ent.onThink(1);sdWorld.UpdateHashPosition(e._shield_ent,false);}}return this.snapshot();}
   };
  });
  const archetypes=['irregular','veteran','officer','infantry','assault','shock'];
  const spawn=await page.evaluate(ids=>ids.map(id=>{const e=integratedFixture.fresh(id);return {id,hp:e.hmax,armor:e.armor,shield:e._shield_ent?.hea??0,team:e._ai_team,training:sdWorld.server_config.humanoid_ai.state(e).tier,box:[e.hitbox_x1,e.hitbox_x2,e.hitbox_y1,e.hitbox_y2]};}),archetypes);
  assert.equal(spawn.length,6);assert(spawn.every(x=>x.hp>=80&&x.hp<=100));assert(spawn[5].shield>spawn[4].shield&&spawn[4].shield>0);assert(spawn.slice(0,3).every(x=>x.shield===0));assert(spawn.every(x=>JSON.stringify(x.box)===JSON.stringify(spawn[0].box)));check('Six native humanoids use biological HP, independent equipment and unchanged hitboxes',spawn);
  // Controlled no-recharge, no-bleed hits-to-defeat; preserve actual gun properties,
  // projectile collisions and layer accounting. This is not live encounter duration.
  r.balance=await page.evaluate(ids=>{const f=integratedFixture,l=sdPhysicalCombat,old=l.tuning.criticalChance;l.tuning.criticalChance=0;try{const rows=[];for(const id of ids)for(const weapon of ['pistol','rifle','railgun'])for(const [region,dy] of [['torso',3],['head',-7]]){const e=f.fresh(id),hits=[];let shots=0;while(e.hea>0&&shots<80){hits.push(f.fire(weapon,dy));shots++;}rows.push({id,weapon,region,shots,defeated:e.hea<=0,remaining:e.hea,first:hits[0],last:hits.at(-1)});}return rows;}finally{l.tuning.criticalChance=old;}},archetypes);
  assert(r.balance.every(x=>x.defeated&&x.shots<80));assert.equal(r.balance.find(x=>x.id==='irregular'&&x.weapon==='pistol'&&x.region==='head').shots,1);assert.equal(r.balance.find(x=>x.id==='irregular'&&x.weapon==='rifle'&&x.region==='head').shots,1);
  assert(r.balance.find(x=>x.id==='shock'&&x.weapon==='rifle'&&x.region==='torso').shots>r.balance.find(x=>x.id==='irregular'&&x.weapon==='rifle'&&x.region==='torso').shots);check('All six archetypes defeated with native pistol, rifle and railgun head/torso fire',r.balance.map(({id,weapon,region,shots})=>({id,weapon,region,shots})));
  // Additional layer assertions are appended after the implementation API stabilizes.
  assert.equal(r.errors.length,0);assert.equal(r.external.length,0);assert(r.badResponses.every(u=>u.endsWith('/audio/rocket_loop.wav')));r.passed=true;
 }catch(e){r.failure=e.stack;throw e;}finally{fs.writeFileSync(dir+'/validation.json',JSON.stringify(r,null,2));await browser.close();}
})().catch(e=>{console.error(e);process.exitCode=1});
